# Copy to .env and fill in. NEVER commit real values.
NODE_ENV=development
PORT=3000

# PostgreSQL (local docker-compose defaults)
DATABASE_URL="postgresql://referral:referral@127.0.0.1:5432/referral?schema=referral_app"
DIRECT_URL="postgresql://referral:referral@127.0.0.1:5432/referral?schema=referral_app"

# Redis / BullMQ (wired in a later sprint)
REDIS_URL="redis://127.0.0.1:6379"

# Main-app HMAC webhook secret for verified server-to-server events. Use a secret manager in real environments.
MAIN_APP_WEBHOOK_SECRET="dev-only-change-me"

# Referral links
REFERRAL_LINK_BASE_URL="https://andostpsite.vercel.app/#ref="

# TEMPORARY Phase-1 identity strategy: trust the x-user-id header. Must stay false in production.
TRUSTED_USER_HEADER_AUTH="false"

# Admin API key for the authorized referral-code views (placeholder until the Phase-5 admin console).
ADMIN_API_KEY="dev-admin-key-change-me"

# Global request throttle (public click endpoint has its own stricter limit)
THROTTLE_LIMIT="300"
THROTTLE_TTL_MS="60000"

# Swagger UI toggle — default OFF (production-safe); set true for local/staging
DOCS_ENABLED=true

# Comma-separated exact browser origins allowed to call the API (empty = CORS disabled)
CORS_ALLOWED_ORIGINS=https://andostpsite.vercel.app

# ── Sprint 4 ────────────────────────────────────────────────────────────────
# Replay defence for signed webhooks: max accepted clock skew for x-andos-timestamp.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Make x-andos-timestamp mandatory (signature bound over "timestamp.rawBody"). REQUIRED in production.
WEBHOOK_REQUIRE_TIMESTAMP=false

# Secret pepper for visitor-token hashing (click dedupe). REQUIRED in production (min 16 chars).
VISITOR_HASH_PEPPER=

# Express trust proxy: false | true | hop count | IP/CIDR list (e.g. "loopback, 10.0.0.0/8")
TRUST_PROXY=false

# One structured JSON log line per request (set false in tests)
REQUEST_LOG_ENABLED=true

# Acting admin user for payout decisions (approve/reject/complete). Admin payout calls answer 503 without it.
ADMIN_ACTOR_USER_ID=
